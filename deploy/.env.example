# Copy to deploy/.env and edit. Paths are relative to the deploy/ directory.

# Merged checkpoint directory on the host (config.json, model.safetensors, tokenizer + preprocessor files).
MODEL_DIR=../outputs/lora-1.7b-malay50h-babel/merged

# Name clients send in the "model" field.
SERVED_NAME=qwen3-asr-malay

# Host port == container port.
PORT=8100

# fp8  : online weight-only FP8 of the LLM linears (--quantization fp8); near-lossless, ~half the LLM weight memory.
#        Native FP8 GEMMs on compute capability >= 8.9 (L4, RTX 40xx/50xx, H100/H200, B200); Ampere (A100/A10/RTX 30xx)
#        falls back to vLLM's FP8-Marlin weight-only kernel (still works, same memory saving).
# none : plain bf16 weights (any Ampere+ GPU; set DTYPE=float16 for Turing/Volta).
QUANT=fp8
DTYPE=bfloat16

# vLLM scheduler / memory knobs (same values as the Vietnamese track's serve_vllm.sh except GPU_MEM).
MAX_SEQS=96
MAX_MODEL_LEN=4096
MAX_BATCHED=16384
GPU_MEM=0.9

# Optional bearer token for /v1/* (leave empty for no auth; keep the port behind a firewall then).
API_KEY=

# Optional extra `vllm serve` flags appended verbatim, e.g. "--enforce-eager" or "--kv-cache-dtype fp8".
EXTRA_ARGS=

# Optional: serve a Hugging Face repo instead of the bind mount (MODEL_DIR is then ignored by the server).
# MODEL_PATH=duclvQ/qwen3-asr-1.7b-vimd-full
# HF_TOKEN=
# HF_CACHE=/data/hf-cache
